{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elyne.eval.toolchain-report/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "campaign_id", "seed", "battery", "matcher", "subjects", "fairness", "items", "patterns", "overall"],
  "properties": {
    "schema": {"const": "elyne.eval.toolchain-report/v1"},
    "status": {"enum": ["completed", "noncomplete"]},
    "campaign_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "seed": {"const": 0},
    "battery": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256", "source_sha256"], "properties": {"id": {"const": "toolchain"}, "revision": {"const": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}}},
    "matcher": {"type": "object", "additionalProperties": false, "required": ["schema", "source_sha256"], "properties": {"schema": {"const": "elyne.eval.toolchain-matcher/v1"}, "source_sha256": {"$ref": "#/$defs/sha256"}}},
    "subjects": {"type": "array", "prefixItems": [{"const": "core-origin"}, {"const": "gemma-info"}, {"const": "gemma-nu"}], "items": false},
    "fairness": {"type": "object", "additionalProperties": false, "required": ["same_binding_identity", "same_sampling", "same_seed", "direct_arms_tools_disabled", "gemma_info_stage", "tool_results_never_prefed", "live_network_used", "local_sources_content_addressed"], "properties": {"same_binding_identity": {"const": true}, "same_sampling": {"const": true}, "same_seed": {"const": true}, "direct_arms_tools_disabled": {"const": true}, "gemma_info_stage": {"const": "before-tool-1"}, "tool_results_never_prefed": {"const": true}, "live_network_used": {"const": false}, "local_sources_content_addressed": {"const": true}}},
    "items": {"type": "array", "minItems": 12, "maxItems": 20, "items": {"$ref": "#/$defs/item"}},
    "patterns": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/aggregate"}},
    "overall": {"$ref": "#/$defs/aggregate"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "arguments": {"type": "object"},
    "trace": {"type": "object", "additionalProperties": false, "required": ["ordinal", "tool_id", "arguments", "outcome", "reason_code", "arguments_sha256", "result_sha256", "target_line_attested"], "properties": {"ordinal": {"type": "integer", "minimum": 1, "maximum": 4}, "tool_id": {"type": "string"}, "arguments": {"$ref": "#/$defs/arguments"}, "outcome": {"enum": ["completed", "invalid", "unavailable", "failed"]}, "reason_code": {"type": ["string", "null"]}, "arguments_sha256": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/nullableSha"}, "target_line_attested": {"type": "boolean"}}},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["tool_1_selection", "tool_2_selection", "causal_order", "result_integration", "final_accuracy", "no_parasitic_calls"], "properties": {"tool_1_selection": {"type": "boolean"}, "tool_2_selection": {"type": "boolean"}, "causal_order": {"type": "boolean"}, "result_integration": {"type": "boolean"}, "final_accuracy": {"type": "boolean"}, "no_parasitic_calls": {"type": "boolean"}}},
    "arm": {"type": "object", "additionalProperties": false, "required": ["subject_id", "status", "reason_code", "response_text", "response_sha256", "tool_trace", "dimensions", "passed", "binding_sha256", "sampling_sha256", "context_mode", "tools_declared"], "properties": {"subject_id": {"enum": ["core-origin", "gemma-info", "gemma-nu"]}, "status": {"enum": ["completed", "failed"]}, "reason_code": {"type": ["string", "null"]}, "response_text": {"type": ["string", "null"]}, "response_sha256": {"$ref": "#/$defs/nullableSha"}, "tool_trace": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/trace"}}, "dimensions": {"$ref": "#/$defs/dimensions"}, "passed": {"type": "boolean"}, "binding_sha256": {"$ref": "#/$defs/sha256"}, "sampling_sha256": {"$ref": "#/$defs/sha256"}, "context_mode": {"enum": ["substrate", "initial-information-only", "user-only"]}, "tools_declared": {"type": "boolean"}}},
    "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["identifier", "schema_id", "relative_path", "sha256", "size_bytes"], "properties": {"identifier": {"enum": ["case-result", "planted-sources", "replayed-material", "tool-trace"]}, "schema_id": {"enum": ["elyne.eval.toolchain-case-result/v1", "elyne.eval.toolchain-planted-sources/v1", "elyne.eval.toolchain-replayed-material/v1", "elyne.eval.toolchain-tool-trace/v1"]}, "relative_path": {"type": "string", "pattern": "^cases/[a-z0-9._-]+/evidence/[a-z0-9-]+\\.json$"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["id", "pattern", "case_sha256", "core_origin", "gemma_info", "gemma_nu", "evidence"], "properties": {"id": {"type": "string"}, "pattern": {"enum": ["route-document", "list-read", "search-read"]}, "case_sha256": {"$ref": "#/$defs/sha256"}, "core_origin": {"$ref": "#/$defs/arm"}, "gemma_info": {"$ref": "#/$defs/arm"}, "gemma_nu": {"$ref": "#/$defs/arm"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["case_result", "planted_sources", "replayed_material", "tool_trace"], "properties": {"case_result": {"$ref": "#/$defs/evidenceRef"}, "planted_sources": {"$ref": "#/$defs/evidenceRef"}, "replayed_material": {"$ref": "#/$defs/evidenceRef"}, "tool_trace": {"$ref": "#/$defs/evidenceRef"}}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["core_origin", "gemma_info", "gemma_nu"], "properties": {"core_origin": {"type": "integer", "minimum": 0}, "gemma_info": {"type": "integer", "minimum": 0}, "gemma_nu": {"type": "integer", "minimum": 0}}},
    "rates": {"type": "object", "additionalProperties": false, "required": ["core_origin", "gemma_info", "gemma_nu"], "properties": {"core_origin": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "gemma_info": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "gemma_nu": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "deltas": {"type": "object", "additionalProperties": false, "required": ["substrate", "orchestration", "access"], "properties": {"substrate": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "orchestration": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "access": {"type": ["number", "null"], "minimum": -1, "maximum": 1}}},
    "dimensionRates": {"type": "object", "additionalProperties": false, "required": ["tool_1_selection", "tool_2_selection", "causal_order", "result_integration", "final_accuracy", "no_parasitic_calls"], "properties": {"tool_1_selection": {"$ref": "#/$defs/rates"}, "tool_2_selection": {"$ref": "#/$defs/rates"}, "causal_order": {"$ref": "#/$defs/rates"}, "result_integration": {"$ref": "#/$defs/rates"}, "final_accuracy": {"$ref": "#/$defs/rates"}, "no_parasitic_calls": {"$ref": "#/$defs/rates"}}},
    "aggregate": {"type": "object", "additionalProperties": false, "required": ["group", "items", "scored_items", "noncomplete", "successes", "rates", "deltas", "dimension_rates"], "properties": {"group": {"enum": ["all", "route-document", "list-read", "search-read"]}, "items": {"type": "integer", "minimum": 0}, "scored_items": {"type": "integer", "minimum": 0}, "noncomplete": {"type": "integer", "minimum": 0}, "successes": {"$ref": "#/$defs/counts"}, "rates": {"$ref": "#/$defs/rates"}, "deltas": {"$ref": "#/$defs/deltas"}, "dimension_rates": {"$ref": "#/$defs/dimensionRates"}}}
  }
}
