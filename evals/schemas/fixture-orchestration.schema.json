{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elyne.eval.fixture-orchestration/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "revision", "status", "catalog", "source", "cases"],
  "properties": {
    "schema": {"const": "elyne.eval.fixture-orchestration/v1"},
    "id": {"const": "orchestration"},
    "revision": {"const": 1},
    "status": {"enum": ["proposed", "accepted", "frozen"]},
    "catalog": {"$ref": "#/$defs/catalog"},
    "source": {"$ref": "#/$defs/source"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 65536},
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {"id": {"const": "orchestration"}, "revision": {"const": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "sha256"],
      "properties": {"module": {"const": "elyne/bench/orchestration_testset.py"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "expectedMatch": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "value", "normalization", "case_sensitive"],
      "properties": {
        "mode": {"const": "contains"}, "value": {"$ref": "#/$defs/text"},
        "normalization": {"const": "unicode-nfc-trim/v1"}, "case_sensitive": {"const": false}
      }
    },
    "message": {
      "type": "object", "additionalProperties": false, "required": ["role", "text"],
      "properties": {"role": {"enum": ["user", "assistant"]}, "text": {"$ref": "#/$defs/text"}}
    },
    "infoMaterial": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "prior_turns": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/message"}},
        "raw_messages": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/text"}},
        "session_break_after": {"type": "integer", "minimum": 1, "maximum": 64},
        "interrupted": {"type": "boolean"}
      },
      "dependentRequired": {"session_break_after": ["prior_turns"], "interrupted": ["prior_turns"]}
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "probe_id", "case_type", "timeout_seconds", "family", "property", "prompt", "just_signal", "expected_match", "expects_tool", "core_product", "info_material"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "probe_id": {"const": "orchestration.answer"},
        "case_type": {"enum": ["objective", "tool", "judge"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "family": {"enum": ["multi-tour", "inter-session", "consolidation", "revision", "tool-chain", "interruption", "selection"]},
        "property": {"enum": ["maintien-etat", "selection-memoire", "revision-correcte", "chaine-outils", "reprise"]},
        "prompt": {"$ref": "#/$defs/text"}, "just_signal": {"$ref": "#/$defs/text"},
        "expected_match": {"oneOf": [{"$ref": "#/$defs/expectedMatch"}, {"type": "null"}]},
        "expects_tool": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "core_product": {"type": "object"}, "info_material": {"$ref": "#/$defs/infoMaterial"}
      }
    }
  }
}
