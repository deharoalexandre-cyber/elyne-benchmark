{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elyne.eval.justesse-report/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "campaign_id", "seed", "battery", "subjects",
    "fairness", "items", "categories", "overall", "judge_triplets", "judge_key_sha256"
  ],
  "properties": {
    "schema": {"const": "elyne.eval.justesse-report/v2"},
    "status": {"enum": ["completed", "noncomplete"]},
    "campaign_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "seed": {"const": 0},
    "battery": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "sha256", "source_sha256"],
      "properties": {
        "id": {"const": "justesse"}, "revision": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subjects": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["core-origin", "gemma-info", "gemma-nu"]}
    },
    "fairness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "same_live_binding", "same_sampling", "same_seed",
        "core_information_replayed_exactly", "gemma_info_tools_disabled",
        "gemma_nu_user_only"
      ],
      "properties": {
        "same_live_binding": {"const": true},
        "same_sampling": {"const": true},
        "same_seed": {"const": true},
        "core_information_replayed_exactly": {"const": true},
        "gemma_info_tools_disabled": {"const": true},
        "gemma_nu_user_only": {"const": true}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "categories": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "#/$defs/aggregate"}
    },
    "overall": {"$ref": "#/$defs/aggregate"},
    "judge_triplets": {"type": "array", "items": {"$ref": "#/$defs/judgeTriplet"}},
    "judge_key_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": [
        "subject_id", "status", "reason_code", "response_text", "response_sha256",
        "tool_calls", "scoring_rule", "expected_tool_called", "grounded", "passed",
        "binding_sha256", "sampling_sha256", "information_sha256"
      ],
      "properties": {
        "subject_id": {"enum": ["core-origin", "gemma-info", "gemma-nu"]},
        "status": {"enum": ["completed", "failed"]},
        "reason_code": {"type": ["string", "null"]},
        "response_text": {"type": ["string", "null"]},
        "response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "tool_calls": {"type": "array", "items": {"type": "string"}},
        "scoring_rule": {
          "enum": ["expected-match", "tool-call-plus-grounding", "grounding-only", "judge-pending"]
        },
        "expected_tool_called": {"type": ["boolean", "null"]},
        "grounded": {"type": ["boolean", "null"]},
        "passed": {"type": ["boolean", "null"]},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "sampling_sha256": {"$ref": "#/$defs/sha256"},
        "information_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "contrastOutcome": {
      "enum": ["left-only", "both", "right-only", "neither", "judge-pending", "noncomplete"]
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "category", "scoring", "substrate_should_help", "setup_sha256",
        "core_origin", "gemma_info", "gemma_nu", "contrasts", "evidence"
      ],
      "properties": {
        "id": {"type": "string"},
        "category": {"enum": ["memoire", "rag", "outils", "temps", "temoin"]},
        "scoring": {"enum": ["objective", "tool", "judge"]},
        "substrate_should_help": {"type": "boolean"},
        "setup_sha256": {"$ref": "#/$defs/sha256"},
        "core_origin": {"$ref": "#/$defs/arm"},
        "gemma_info": {"$ref": "#/$defs/arm"},
        "gemma_nu": {"$ref": "#/$defs/arm"},
        "contrasts": {
          "type": "object", "additionalProperties": false,
          "required": ["substrate_vs_bare", "orchestration", "access"],
          "properties": {
            "substrate_vs_bare": {"$ref": "#/$defs/contrastOutcome"},
            "orchestration": {"$ref": "#/$defs/contrastOutcome"},
            "access": {"$ref": "#/$defs/contrastOutcome"}
          }
        },
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["case_result", "surfaced_information", "tool_call_trace"],
          "properties": {
            "case_result": {"$ref": "#/$defs/evidenceRef"},
            "surfaced_information": {"$ref": "#/$defs/evidenceRef"},
            "tool_call_trace": {"$ref": "#/$defs/evidenceRef"}
          }
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["core_origin", "gemma_info", "gemma_nu"],
      "properties": {
        "core_origin": {"type": "integer", "minimum": 0},
        "gemma_info": {"type": "integer", "minimum": 0},
        "gemma_nu": {"type": "integer", "minimum": 0}
      }
    },
    "rates": {
      "type": "object", "additionalProperties": false,
      "required": ["core_origin", "gemma_info", "gemma_nu"],
      "properties": {
        "core_origin": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "gemma_info": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "gemma_nu": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "deltas": {
      "type": "object", "additionalProperties": false,
      "required": ["substrate", "orchestration", "access"],
      "properties": {
        "substrate": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "orchestration": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "access": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
      }
    },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "category", "items", "scored_items", "judge_pending", "noncomplete",
        "successes", "rates", "deltas"
      ],
      "properties": {
        "category": {"enum": ["all", "memoire", "rag", "outils", "temps", "temoin"]},
        "items": {"type": "integer", "minimum": 0},
        "scored_items": {"type": "integer", "minimum": 0},
        "judge_pending": {"type": "integer", "minimum": 0},
        "noncomplete": {"type": "integer", "minimum": 0},
        "successes": {"$ref": "#/$defs/counts"},
        "rates": {"$ref": "#/$defs/rates"},
        "deltas": {"$ref": "#/$defs/deltas"}
      }
    },
    "judgeTriplet": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_id", "category", "prompt", "just_signal",
        "response_a", "response_b", "response_c", "assignment_sha256"
      ],
      "properties": {
        "item_id": {"type": "string"}, "category": {"type": "string"},
        "prompt": {"type": "string"}, "just_signal": {"type": "string"},
        "response_a": {"type": "string"}, "response_b": {"type": "string"},
        "response_c": {"type": "string"},
        "assignment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "schema_id", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "identifier": {"enum": ["case-result", "surfaced-information", "tool-call-trace"]},
        "schema_id": {
          "enum": [
            "elyne.eval.justesse-case-result/v2",
            "elyne.eval.justesse-surfaced-information/v1",
            "elyne.eval.justesse-tool-call-trace/v2"
          ]
        },
        "relative_path": {"type": "string", "pattern": "^cases/[a-z0-9._-]+/evidence/[a-z0-9-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
