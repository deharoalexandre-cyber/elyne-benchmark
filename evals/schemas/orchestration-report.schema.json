{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elyne.eval.orchestration-report/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "campaign_id", "seed", "battery", "matcher", "subjects", "fairness", "items", "properties", "overall", "judge_triplets", "judge_key_sha256"],
  "properties": {
    "schema": {"const": "elyne.eval.orchestration-report/v2"},
    "status": {"enum": ["completed", "noncomplete"]},
    "campaign_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "seed": {"const": 0},
    "battery": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "sha256", "source_sha256"],
      "properties": {
        "id": {"const": "orchestration"}, "revision": {"const": 2},
        "sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "matcher": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "source_sha256"],
      "properties": {
        "schema": {"const": "elyne.eval.toolchain-matcher/v1"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subjects": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["core-origin", "gemma-info", "gemma-nu"]}},
    "fairness": {
      "type": "object", "additionalProperties": false,
      "required": ["same_binding_identity", "same_sampling", "same_seed", "gemma_info_raw_material_only", "core_product_never_replayed", "direct_arms_tools_disabled", "tool_chain_not_prefed", "tool_chain_exact_trace_scoring", "inter_session_real_restart"],
      "properties": {
        "same_binding_identity": {"const": true}, "same_sampling": {"const": true}, "same_seed": {"const": true},
        "gemma_info_raw_material_only": {"const": true}, "core_product_never_replayed": {"const": true},
        "direct_arms_tools_disabled": {"const": true}, "tool_chain_not_prefed": {"const": true},
        "tool_chain_exact_trace_scoring": {"const": true}, "inter_session_real_restart": {"const": true}
      }
    },
    "items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/item"}},
    "properties": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/aggregate"}},
    "overall": {"$ref": "#/$defs/aggregate"},
    "judge_triplets": {"type": "array", "items": {"$ref": "#/$defs/judgeTriplet"}},
    "judge_key_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "toolTraceEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "tool_id", "arguments", "outcome", "reason_code", "arguments_sha256", "result_sha256", "target_line_attested"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4},
        "tool_id": {"type": "string", "minLength": 1}, "arguments": {"type": "object"},
        "outcome": {"enum": ["completed", "invalid", "unavailable", "failed"]},
        "reason_code": {"type": ["string", "null"]},
        "arguments_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/nullableSha256"},
        "target_line_attested": {"type": "boolean"}
      }
    },
    "dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_1_selection", "tool_2_selection", "causal_order", "result_integration", "final_accuracy", "no_parasitic_calls"],
      "properties": {
        "tool_1_selection": {"type": "boolean"}, "tool_2_selection": {"type": "boolean"},
        "causal_order": {"type": "boolean"}, "result_integration": {"type": "boolean"},
        "final_accuracy": {"type": "boolean"}, "no_parasitic_calls": {"type": "boolean"}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "status", "reason_code", "response_text", "response_sha256", "tool_calls", "tool_trace", "scoring_rule", "expected_tool_called", "grounded", "dimensions", "passed", "binding_sha256", "sampling_sha256", "material_sha256"],
      "properties": {
        "subject_id": {"enum": ["core-origin", "gemma-info", "gemma-nu"]},
        "status": {"enum": ["completed", "failed"]}, "reason_code": {"type": ["string", "null"]},
        "response_text": {"type": ["string", "null"]}, "response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "tool_calls": {"type": "array", "items": {"type": "string"}},
        "tool_trace": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/toolTraceEntry"}},
        "scoring_rule": {"enum": ["expected-match", "causal-tool-chain/v1", "judge-pending"]},
        "expected_tool_called": {"type": ["boolean", "null"]}, "grounded": {"type": ["boolean", "null"]},
        "dimensions": {"oneOf": [{"$ref": "#/$defs/dimensions"}, {"type": "null"}]},
        "passed": {"type": ["boolean", "null"]},
        "binding_sha256": {"$ref": "#/$defs/sha256"}, "sampling_sha256": {"$ref": "#/$defs/sha256"},
        "material_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "contrast": {"enum": ["left-only", "both", "right-only", "neither", "judge-pending", "noncomplete"]},
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "schema_id", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "identifier": {"enum": ["case-result", "replayed-material", "session-trace", "tool-call-trace"]},
        "schema_id": {"enum": ["elyne.eval.orchestration-case-result/v1", "elyne.eval.orchestration-replayed-material/v1", "elyne.eval.orchestration-session-trace/v1", "elyne.eval.orchestration-tool-call-trace/v2"]},
        "relative_path": {"type": "string", "pattern": "^cases/[a-z0-9._-]+/evidence/[a-z0-9-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family", "property", "scoring", "core_product_sha256", "info_material_sha256", "core_origin", "gemma_info", "gemma_nu", "contrasts", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "family": {"enum": ["multi-tour", "inter-session", "consolidation", "revision", "tool-chain", "interruption", "selection"]},
        "property": {"enum": ["maintien-etat", "selection-memoire", "revision-correcte", "chaine-outils", "reprise"]},
        "scoring": {"enum": ["objective", "tool", "judge"]},
        "core_product_sha256": {"$ref": "#/$defs/sha256"}, "info_material_sha256": {"$ref": "#/$defs/sha256"},
        "core_origin": {"$ref": "#/$defs/arm"}, "gemma_info": {"$ref": "#/$defs/arm"}, "gemma_nu": {"$ref": "#/$defs/arm"},
        "contrasts": {
          "type": "object", "additionalProperties": false, "required": ["substrate_vs_bare", "orchestration", "access"],
          "properties": {"substrate_vs_bare": {"$ref": "#/$defs/contrast"}, "orchestration": {"$ref": "#/$defs/contrast"}, "access": {"$ref": "#/$defs/contrast"}}
        },
        "evidence": {
          "type": "object", "additionalProperties": false, "required": ["case_result", "replayed_material", "session_trace", "tool_call_trace"],
          "properties": {"case_result": {"$ref": "#/$defs/evidenceRef"}, "replayed_material": {"$ref": "#/$defs/evidenceRef"}, "session_trace": {"$ref": "#/$defs/evidenceRef"}, "tool_call_trace": {"$ref": "#/$defs/evidenceRef"}}
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["core_origin", "gemma_info", "gemma_nu"],
      "properties": {"core_origin": {"type": "integer", "minimum": 0}, "gemma_info": {"type": "integer", "minimum": 0}, "gemma_nu": {"type": "integer", "minimum": 0}}
    },
    "rates": {
      "type": "object", "additionalProperties": false, "required": ["core_origin", "gemma_info", "gemma_nu"],
      "properties": {"core_origin": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "gemma_info": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "gemma_nu": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
    },
    "deltas": {
      "type": "object", "additionalProperties": false, "required": ["substrate", "orchestration", "access"],
      "properties": {"substrate": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "orchestration": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "access": {"type": ["number", "null"], "minimum": -1, "maximum": 1}}
    },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "items", "scored_items", "judge_pending", "noncomplete", "successes", "rates", "deltas"],
      "properties": {
        "property": {"enum": ["all", "maintien-etat", "selection-memoire", "revision-correcte", "chaine-outils", "reprise"]},
        "items": {"type": "integer", "minimum": 0}, "scored_items": {"type": "integer", "minimum": 0},
        "judge_pending": {"type": "integer", "minimum": 0}, "noncomplete": {"type": "integer", "minimum": 0},
        "successes": {"$ref": "#/$defs/counts"}, "rates": {"$ref": "#/$defs/rates"}, "deltas": {"$ref": "#/$defs/deltas"}
      }
    },
    "judgeTriplet": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "property", "prompt", "just_signal", "response_a", "response_b", "response_c", "assignment_sha256"],
      "properties": {"item_id": {"type": "string"}, "property": {"type": "string"}, "prompt": {"type": "string"}, "just_signal": {"type": "string"}, "response_a": {"type": "string"}, "response_b": {"type": "string"}, "response_c": {"type": "string"}, "assignment_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
