    "timeout_seconds": 3600,
    "evidence": [
      {"id": "case-result", "media_type": "application/json", "required_when": "always"},
      {"id": "planted-sources", "media_type": "application/json", "required_when": "always"},
      {"id": "replayed-material", "media_type": "application/json", "required_when": "always"},
      {"id": "tool-trace", "media_type": "application/json", "required_when": "always"}
    ]
  }]
}
