{
  "schema": "elyne.eval.probe-catalog/v1",
  "id": "toolchain",
  "revision": 1,
  "status": "accepted",
  "fixture_schemas": ["elyne.eval.fixture-toolchain/v1"],
  "isolation": {
    "source_access": "read-only",
    "snapshot_access": "read-only",
    "external_artifacts_access": "read-only",
    "work_dir_access": "read-write",
    "network_access": "forbidden",
    "process_spawn": "driver-owned-only"
  },
  "probes": [{
    "id": "toolchain.execute",
    "phase": "running",
    "handler_id": "probe-handler.toolchain.execute",
